{
  "name": "dsh-zh-review-guard",
  "version": "0.1.1",
  "description": "用户级「内部思考可见 + 简体中文」护栏：每个会话装配系统提示词时强制注入用户需求段（常驻 section），并把同一份文本同步到 $DSH_HOME/AGENTS.md。零依赖、无需编译。",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "engines": {
    "dsh": ">=0.0.1-rc",
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
